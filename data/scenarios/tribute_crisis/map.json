  "scheduled_events": [
    {
      "event": "Bumper Harvest",
      "trigger": {
        "kind": "at_month",
        "value": 6
      }
    },
    {
      "event": "Barbarian Raid",
      "trigger": {
        "kind": "random_after_tick",
        "value": 3600
      }
    },
    {
      "event": "Iron Vein Exhausted",
      "trigger": {
        "kind": "random_after_tick",
        "value": 5400
      }
    }
  ],
  "disable_random_events": false,
  "triggers": [
    {
      "id": "intro_on_start",
      "when": {
        "kind": "at_tick",
        "value": 0
      },
      "do": [
        {
          "kind": "play_cutscene",
          "id": "intro_tribute_crisis"
        }
      ],
      "once": true,
      "notes": "Opening narration on the first tick of the scenario."
    },
    {
      "id": "messenger_arrives_when_town_grows",
      "when": {
        "kind": "on_population_above",
        "value": 100
      },
      "do": [
        {
          "kind": "fire_request",
          "id": "caesar_tribute_500_scenario"
        }
      ],
      "once": true,
      "notes": "Once the town has clearly prospered (pop > 100, ~40 over the start of 60), Caesar takes notice and the tribune arrives. Pre-v0.36 used 80 \u2014 too easy to hit accidentally before the player had a chance to settle in."
    },
    {
      "id": "branch_pleased",
      "when": {
        "kind": "on_flag",
        "flag": "tribute_paid"
      },
      "do": [
        {
          "kind": "play_cutscene",
          "id": "cutscene_caesar_pleased"
        },
        {
          "kind": "schedule_event",
          "event": "Frontier Trade Boom",
          "trigger": {
            "kind": "at_tick",
            "value": 7200
          }
        }
      ],
      "once": true,
      "notes": "Payment branch: cinematic + delayed economic reward. Schedules the scenario-local 'Frontier Trade Boom' (in events.json) rather than the global 'Trade Boom' \u2014 keeps the scenario self-contained and lets future tuning pass touch only this scenario's events file."
    },
    {
      "id": "branch_partial",
      "when": {
        "kind": "on_flag",
        "flag": "tribute_partial"
      },
      "do": [
        {
          "kind": "play_cutscene",
          "id": "cutscene_caesar_uneasy"
        },
        {
          "kind": "fire_event",
          "name": "Caesar Displeased"
        }
      ],
      "once": true,
      "notes": "Partial-tribute branch (player paid gold but withheld iron). Fires the displeased event for the trade-profit debuff, plays an interstitial cutscene between 'pleased' and 'wrath'. Does NOT schedule the accelerated raid \u2014 only outright refusal does that."
    },
    {
      "id": "branch_refused",
      "when": {
        "kind": "on_flag",
        "flag": "tribute_refused"
      },
      "do": [
        {
          "kind": "play_cutscene",
          "id": "cutscene_caesar_wrath"
        },
        {
          "kind": "fire_event",
          "name": "Caesar Displeased"
        },
        {
          "kind": "schedule_event",
          "event": "Barbarian Raid",
          "trigger": {
            "kind": "at_tick",
            "value": 3600
          }
        }
      ],
      "once": true,
      "notes": "Refusal branch: cinematic + diplomatic event + accelerated raid."
    },
    {
      "id": "raid_survivor_arrives",
      "when": {
        "kind": "on_event_fired",
        "event": "Barbarian Raid"
      },
      "do": [
        {
          "kind": "fire_request",
          "id": "raid_aftermath_scenario"
        }
      ],
      "once": true,
      "notes": "After a raid hits, a survivor brings a follow-up choice."
    },
    {
      "id": "branch_raid_abandoned",
      "when": {
        "kind": "on_flag",
        "flag": "barbarian_raid_abandoned"
      },
      "do": [
        {
          "kind": "play_cutscene",
          "id": "cutscene_raid_abandoned"
        }
      ],
      "once": true,
      "notes": "Player chose 'Send them away' in raid_aftermath_scenario. Soft-fail cinematic \u2014 no mechanical penalty beyond the happiness hit the decision itself carries; the cost is narrative."
    },
    {
      "id": "victory_path",
      "when": {
        "kind": "on_flag",
        "flag": "barbarian_raid_survived"
      },
      "do": [
        {
          "kind": "play_cutscene",
          "id": "cutscene_victory"
        }
      ],
      "once": true,
      "notes": "Survive the raid + stabilize \u2192 victory cinematic."
    },
    {
      "id": "defeat_on_collapse",
      "when": {
        "kind": "on_treasury_below",
        "value": -200
      },
      "do": [
        {
          "kind": "set_flag",
          "flag": "treasury_collapsed"
        },
        {
          "kind": "play_cutscene",
          "id": "cutscene_defeat"
        }
      ],
      "once": true,
      "notes": "Hard fail: treasury crashes through -200 \u2192 defeat cinematic."
    },
    {
      "id": "winter_blizzard_chance",
      "when": {
        "kind": "in_season_random",
        "season": "Winter",
        "prob": 0.01
      },
      "do": [
        {
          "kind": "fire_event",
          "name": "Blizzard"
        }
      ],
      "once": false,
      "notes": "v0.37 example: every winter tick, 1% chance to fire the Blizzard event. once=false so the weather can hit multiple times across the scenario."
    },
    {
      "id": "plague_on_doctor_shortage",
      "when": {
        "kind": "on_building_ratio_below",
        "building": "clinic",
        "per": "population",
        "value": 1.0
      },
      "do": [
        {
          "kind": "fire_event",
          "name": "Plague"
        }
      ],
      "once": true,
      "notes": "v0.37 example: fires Plague when clinics-per-1000-inhabitants drops below 1.0 (i.e. < 0.1% of the population has a nearby clinic). once=true so a single under-served winter doesn't cascade into a chain of plagues; author can clone the entry with a different id for repeat outbreaks."
    }
  ],
  "scenario_libraries": {
    "cutscenes": "scenarios/tribute_crisis/cutscenes.json",
    "rpg_requests": "scenarios/tribute_crisis/rpg_requests.json",
    "events": "scenarios/tribute_crisis/events.json"
  }
